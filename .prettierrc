{
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "semi": true,
  "singleQuote": false,
  "bracketSpacing": true,
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": ["gui/**/*"],
      "options": {
        "tailwindStylesheet": "./gui/src/index.css"
      }
    }
  ]
}

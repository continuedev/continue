{
  "name": "@b1tninja/continuous-cli",
  "version": "0.0.0-dev",
  "description": "Continuous CLI: the terminal agent of Continuous, a community fork of Continue",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "continuous": "dist/cn.js"
  },
  "files": [
    "dist/index.js",
    "dist/cn.js",
    "dist/xhr-sync-worker.js",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:smoke": "node smoke-test.mjs",
    "test:smoke-api": "vitest run --config vitest.smoke-api.config.ts",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:local-deps": "cd ../../packages/config-types && npm i && npm run build && cd ../fetch && npm i && npm run build && cd ../llm-info && npm i && npm run build && cd ../terminal-security && npm i && npm run build && cd ../config-yaml && npm i && npm run build && cd ../openai-adapters && npm i && npm run build && cd ../../core && npm i && npm run build && cd ../extensions/cli && npm i",
    "build:validate": "node validate-aliases.mjs",
    "build:bundle": "node build.mjs",
    "build": "npm run build:validate && npm run build:bundle",
    "start": "node dist/cn.js",
    "dev": "tsx src/index.ts",
    "repomix:sdk": "npx repomix node_modules/@continuedev/sdk --ignore **/api,cli-repomix.xml -o sdk-repomix.xml",
    "repomix:cli": "npx repomix --ignore sdk-repomix.xml -o cli-repomix.xml",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "watch:logs": "touch ~/.continuous/logs/cn.log && tail -f ~/.continuous/logs/cn.log",
    "prepare": "npm run build"
  },
  "author": "Continue Dev, Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/b1tninja/continuous.git",
    "directory": "extensions/cli"
  },
  "bugs": {
    "url": "https://github.com/b1tninja/continuous/issues"
  },
  "homepage": "https://github.com/b1tninja/continuous",
  "dependencies": {
    "fdir": "^6.4.2",
    "find-up": "^8.0.0",
    "fzf": "^0.5.2"
  },
  "devDependencies": {
    "@continuedev/config-yaml": "file:../../packages/config-yaml",
    "@continuedev/openai-adapters": "file:../../packages/openai-adapters",
    "@continuedev/sdk": "^0.0.13",
    "@continuedev/terminal-security": "file:../../packages/terminal-security",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-fs": "^0.43.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@testing-library/react": "^16.3.0",
    "@types/date-fns": "^2.6.3",
    "@types/express": "^5.0.3",
    "@types/ignore-walk": "^4.0.3",
    "@types/ink-testing-library": "^1.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/shell-quote": "^1.7.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitest/ui": "^5.1.0",
    "@workos-inc/node": "^12.1.0",
    "chalk": "^6.0.1",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "core": "file:../../core",
    "date-fns": "^4.1.0",
    "diff": "^8.0.4",
    "dotenv": "^16.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "execa": "^10.2.1",
    "express": "^5.1.0",
    "gpt-tokenizer": "^4.1.0",
    "gradient-string": "^3.0.0",
    "ignore-walk": "^9.0.0",
    "ink": "^8.0.0",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^26.1.0",
    "lowlight": "^3.3.0",
    "nock": "^15.0.5",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "shell-quote": "^1.8.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "uuid": "^11.1.1",
    "vitest": "^5.1.0",
    "winston": "^3.17.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "qs": "^6.14.2",
    "picomatch": "^4.0.2",
    "openai": {
      "zod": "$zod"
    },
    "iron-session": {
      "cookie": "^0.7.2"
    }
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "^0.35.5",
    "@img/sharp-darwin-x64": "^0.35.5",
    "@img/sharp-linux-arm": "^0.35.5",
    "@img/sharp-linux-arm64": "^0.35.5",
    "@img/sharp-linux-x64": "^0.35.5",
    "@img/sharp-win32-x64": "^0.35.5"
  }
}

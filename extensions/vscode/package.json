{
  "name": "continuous",
  "icon": "media/icon.png",
  "author": "b1tninja",
  "version": "2.4.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/b1tninja/continuous"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "bugs": {
    "url": "https://github.com/b1tninja/continuous/issues"
  },
  "homepage": "https://github.com/b1tninja/continuous",
  "qna": "https://github.com/b1tninja/continuous/issues/new/choose",
  "license": "Apache-2.0",
  "displayName": "Continuous",
  "pricing": "Free",
  "description": "Continuous: a community-maintained fork of the Continue open-source AI code agent",
  "publisher": "b1tninja",
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=20.20.1"
  },
  "engine-strict": true,
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "chatgpt",
    "cline",
    "roo",
    "github",
    "copilot",
    "claude",
    "mistral",
    "codestral",
    "ai"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished",
    "onView:continueGUIView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "continuous",
        "displayName": "Continuous"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "continuous.mcpServers",
        "label": "Continuous"
      }
    ],
    "languages": [
      {
        "filenames": [
          "config.json",
          ".continuousrc.json",
          ".continuerc.json"
        ],
        "id": "jsonc"
      },
      {
        "id": "promptLanguage",
        "extensions": [
          ".prompt"
        ],
        "aliases": [
          "Prompt Language"
        ],
        "configuration": "./prompt-file-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "promptLanguage",
        "scopeName": "source.prompt",
        "path": "./media/prompt.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Continuous",
      "properties": {
        "continuous.shareModelsWithVSCode": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the chat models of the selected Continuous config to VS Code's own chat and agents (model picker vendor: Continuous). Requests still go through Continuous with your Continuous keys."
        },
        "continuous.shareMcpServersWithVSCode": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the MCP servers of the selected Continuous config to VS Code's own chat and agents, so they are configured once."
        },
        "continuous.telemetryEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Has no effect: Continuous does not collect telemetry or usage data. Kept so existing settings files stay valid.",
          "markdownDeprecationMessage": "Continuous does not collect telemetry, so this setting does nothing.",
          "deprecationMessage": "Continuous does not collect telemetry, so this setting does nothing."
        },
        "continuous.showInlineTip": {
          "type": "boolean",
          "default": true,
          "description": "Show inline suggestion to use the Continuous keyboard shortcuts (e.g. \"Cmd/Ctrl L to select code, Cmd/Ctrl I to edit\")."
        },
        "continuous.disableQuickFix": {
          "type": "boolean",
          "default": false,
          "description": "Disable the quick fix feature."
        },
        "continuous.enableQuickActions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable the experimental Quick Actions feature. Read our walkthrough to learn about configuration and how to share feedback: [Continuous docs › Walkthrough: Quick Actions (experimental)](https://b1tninja.github.io/continuous/customize/overview)"
        },
        "continuous.enableTabAutocomplete": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable Continuous's tab autocomplete feature. Read our walkthrough to learn about configuration and how to share feedback: [Continuous docs › Walkthrough: Tab Autocomplete (beta)](https://b1tninja.github.io/continuous/customize/deep-dives/autocomplete)"
        },
        "continuous.enableNextEdit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable Continuous's next edit feature. Read our docs to learn about configuration and how to share feedback: [Continuous docs › Features › Autocomplete › Next Edit (experimental)](https://b1tninja.github.io/continuous/ide-extensions/autocomplete/next-edit)"
        },
        "continuous.pauseTabAutocompleteOnBattery": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Pause Continuous's tab autocomplete feature when your battery is low."
        },
        "continuous.pauseCodebaseIndexOnStart": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Pause Continuous's codebase index on start."
        },
        "continuous.enableConsole": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable a console to log and explore model inputs and outputs. It can be found in the bottom panel."
        },
        "continuous.remoteConfigServerUrl": {
          "type": "string",
          "default": null,
          "markdownDescription": "If your team is set up to use shared configuration, enter the server URL here and your user token below to enable automatic syncing."
        },
        "continuous.userToken": {
          "type": "string",
          "default": null,
          "markdownDescription": "If your team is set up to use shared configuration, enter your user token here and your server URL above to enable automatic syncing."
        },
        "continuous.remoteConfigSyncPeriod": {
          "type": "number",
          "default": 60,
          "description": "The period of time in minutes between automatic syncs."
        }
      }
    },
    "commands": [
      {
        "command": "continuous.applyCodeFromChat",
        "category": "Continuous",
        "title": "Apply code from chat",
        "group": "Continuous"
      },
      {
        "command": "continuous.acceptDiff",
        "category": "Continuous",
        "title": "Accept Diff",
        "group": "Continuous"
      },
      {
        "command": "continuous.rejectDiff",
        "category": "Continuous",
        "title": "Reject Diff",
        "group": "Continuous",
        "icon": "$(stop)"
      },
      {
        "command": "continuous.acceptVerticalDiffBlock",
        "category": "Continuous",
        "title": "Accept Vertical Diff Block",
        "group": "Continuous"
      },
      {
        "command": "continuous.rejectVerticalDiffBlock",
        "category": "Continuous",
        "title": "Reject Vertical Diff Block",
        "group": "Continuous"
      },
      {
        "command": "continuous.focusEdit",
        "category": "Continuous",
        "title": "Add to Edit",
        "group": "Continuous"
      },
      {
        "command": "continuous.focusContinuousInput",
        "category": "Continuous",
        "title": "Add Highlighted Code to Context and Clear Chat",
        "group": "Continuous"
      },
      {
        "command": "continuous.focusContinuousInputWithoutClear",
        "category": "Continuous",
        "title": "Add to Chat",
        "group": "Continuous"
      },
      {
        "command": "continuous.debugTerminal",
        "category": "Continuous",
        "title": "Debug Terminal",
        "group": "Continuous"
      },
      {
        "command": "continuous.exitEditMode",
        "category": "Continuous",
        "title": "Exit Edit Mode",
        "group": "Continuous"
      },
      {
        "command": "continuous.openConfigPage",
        "category": "Continuous",
        "title": "Open Settings",
        "icon": "$(gear)",
        "group": "Continuous"
      },
      {
        "command": "continuous.openModelSetup",
        "category": "Continuous",
        "title": "Manage Models and Providers",
        "group": "Continuous"
      },
      {
        "command": "continuous.toggleTabAutocompleteEnabled",
        "category": "Continuous",
        "title": "Toggle Autocomplete Enabled",
        "group": "Continuous"
      },
      {
        "command": "continuous.forceAutocomplete",
        "title": "Continuous: Force Autocomplete",
        "category": "Continuous"
      },
      {
        "command": "continuous.selectFilesAsContext",
        "category": "Continuous",
        "title": "Select Files as Context",
        "group": "Continuous"
      },
      {
        "command": "continuous.newSession",
        "category": "Continuous",
        "title": "New Session",
        "icon": "$(add)",
        "group": "Continuous"
      },
      {
        "command": "continuous.shareSession",
        "category": "Continuous",
        "title": "Share Current Chat Session as Markdown",
        "group": "Continuous"
      },
      {
        "command": "continuous.viewHistory",
        "category": "Continuous",
        "title": "View History",
        "icon": "$(history)",
        "group": "Continuous"
      },
      {
        "command": "continuous.viewLogs",
        "category": "Continuous",
        "title": "View Logs",
        "group": "Continuous"
      },
      {
        "command": "continuous.clearConsole",
        "category": "Continuous",
        "title": "Clear Console",
        "icon": "$(clear-all)",
        "group": "Continuous"
      },
      {
        "command": "continuous.navigateTo",
        "category": "Continuous",
        "title": "Navigate to a path",
        "group": "Continuous"
      },
      {
        "command": "continuous.writeCommentsForCode",
        "category": "Continuous",
        "title": "Write Comments for this Code",
        "group": "Continuous"
      },
      {
        "command": "continuous.writeDocstringForCode",
        "category": "Continuous",
        "title": "Write a Docstring for this Code",
        "group": "Continuous"
      },
      {
        "command": "continuous.fixCode",
        "category": "Continuous",
        "title": "Fix this Code",
        "group": "Continuous"
      },
      {
        "command": "continuous.optimizeCode",
        "category": "Continuous",
        "title": "Optimize this Code",
        "group": "Continuous"
      },
      {
        "command": "continuous.fixGrammar",
        "category": "Continuous",
        "title": "Fix Grammar / Spelling",
        "group": "Continuous"
      },
      {
        "command": "continuous.codebaseForceReIndex",
        "category": "Continuous",
        "title": "Codebase Force Re-Index",
        "group": "Continuous"
      },
      {
        "command": "continuous.rebuildCodebaseIndex",
        "category": "Continuous",
        "title": "Rebuild codebase index",
        "group": "Continuous"
      },
      {
        "command": "continuous.docsIndex",
        "category": "Continuous",
        "title": "Docs Index",
        "group": "Continuous"
      },
      {
        "command": "continuous.docsReIndex",
        "category": "Continuous",
        "title": "Docs Force Re-Index",
        "group": "Continuous"
      },
      {
        "command": "continuous.focusContinuousInput",
        "category": "Continuous",
        "title": "Focus Continuous Chat",
        "group": "Continuous"
      },
      {
        "command": "continuous.enterEnterpriseLicenseKey",
        "category": "Continuous",
        "title": "Enter Enterprise License Key",
        "group": "Continuous"
      },
      {
        "command": "continuous.toggleNextEditEnabled",
        "title": "Continuous: Toggle Next Edit"
      },
      {
        "command": "continuous.nextEditWindow.hideNextEditSuggestion",
        "category": "Continuous",
        "title": "Hide Next Edit Suggestion"
      },
      {
        "command": "continuous.nextEditWindow.acceptNextEditSuggestion",
        "category": "Continuous",
        "title": "Accept Next Edit Suggestion"
      },
      {
        "command": "continuous.forceNextEdit",
        "category": "Continuous",
        "title": "Continuous: Force Next Edit"
      },
      {
        "command": "continuous.acceptJump",
        "category": "Continuous",
        "title": "Continuous: Accept Jump Suggestion"
      },
      {
        "command": "continuous.rejectJump",
        "category": "Continuous",
        "title": "Continuous: Reject Jump Suggestion"
      },
      {
        "command": "continuous.openInNewWindow",
        "category": "Continuous",
        "title": "Open in new window",
        "group": "Continuous"
      }
    ],
    "keybindings": [
      {
        "command": "continuous.focusContinuousInput",
        "mac": "cmd+l",
        "key": "ctrl+l"
      },
      {
        "command": "continuous.focusContinuousInputWithoutClear",
        "mac": "cmd+shift+l",
        "key": "ctrl+shift+l"
      },
      {
        "command": "continuous.acceptDiff",
        "mac": "shift+cmd+enter",
        "key": "shift+ctrl+enter",
        "when": "continuous.diffVisible"
      },
      {
        "command": "continuous.rejectDiff",
        "mac": "shift+cmd+backspace",
        "key": "shift+ctrl+backspace",
        "when": "continuous.diffVisible"
      },
      {
        "command": "continuous.rejectDiff",
        "mac": "cmd+z",
        "key": "ctrl+z",
        "when": "continuous.diffVisible"
      },
      {
        "command": "continuous.quickEditHistoryUp",
        "mac": "up",
        "key": "up",
        "when": "false && continuous.quickEditHistoryFocused"
      },
      {
        "command": "continuous.quickEditHistoryDown",
        "mac": "down",
        "key": "down",
        "when": "false && continuous.quickEditHistoryFocused"
      },
      {
        "command": "continuous.acceptVerticalDiffBlock",
        "mac": "alt+cmd+y",
        "key": "alt+ctrl+y"
      },
      {
        "command": "continuous.rejectVerticalDiffBlock",
        "mac": "alt+cmd+n",
        "key": "alt+ctrl+n"
      },
      {
        "command": "continuous.focusEdit",
        "title": "Edit code with natural language",
        "mac": "cmd+i",
        "key": "ctrl+i"
      },
      {
        "command": "continuous.exitEditMode",
        "mac": "escape",
        "key": "escape",
        "when": "continuous.inEditMode && editorFocus"
      },
      {
        "command": "continuous.debugTerminal",
        "mac": "cmd+shift+r",
        "key": "ctrl+shift+r"
      },
      {
        "command": "continuous.openInNewWindow",
        "mac": "cmd+k cmd+m",
        "key": "ctrl+k ctrl+m",
        "when": "!terminalFocus"
      },
      {
        "command": "continuous.toggleTabAutocompleteEnabled",
        "mac": "cmd+k cmd+a",
        "key": "ctrl+k ctrl+a",
        "when": "!terminalFocus"
      },
      {
        "command": "continuous.forceAutocomplete",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "editorTextFocus && !editorHasSelection && !editorReadOnly && !inSnippetMode"
      },
      {
        "command": "continuous.applyCodeFromChat",
        "mac": "alt+a",
        "key": "alt+a"
      },
      {
        "command": "continuous.toggleNextEditEnabled",
        "key": "ctrl+k ctrl+n",
        "mac": "cmd+k cmd+n",
        "when": "editorTextFocus"
      },
      {
        "command": "continuous.nextEditWindow.hideNextEditSuggestion",
        "key": "escape",
        "when": "editorTextFocus && nextEditWindowActive && !continuous.jumpDecorationVisible"
      },
      {
        "command": "continuous.nextEditWindow.acceptNextEditSuggestion",
        "key": "tab",
        "when": "editorTextFocus && nextEditWindowActive && !continuous.jumpDecorationVisible"
      },
      {
        "command": "continuous.acceptJump",
        "key": "tab",
        "when": "editorTextFocus && continuous.jumpDecorationVisible"
      },
      {
        "command": "continuous.rejectJump",
        "key": "escape",
        "when": "editorTextFocus && continuous.jumpDecorationVisible"
      }
    ],
    "submenus": [
      {
        "id": "continuous.continueSubMenu",
        "label": "Continuous"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "continuous.focusContinuousInput"
        },
        {
          "command": "continuous.focusContinuousInputWithoutClear"
        },
        {
          "command": "continuous.debugTerminal"
        },
        {
          "command": "continuous.newSession"
        },
        {
          "command": "continuous.enterEnterpriseLicenseKey"
        },
        {
          "command": "continuous.openInNewWindow"
        }
      ],
      "editor/context": [
        {
          "submenu": "continuous.continueSubMenu",
          "group": "0_acontinue"
        }
      ],
      "editor/title/run": [
        {
          "command": "continuous.rejectDiff",
          "group": "Continuous",
          "when": "continuous.streamingDiff"
        }
      ],
      "continuous.continueSubMenu": [
        {
          "command": "continuous.focusContinuousInputWithoutClear",
          "group": "Continuous"
        },
        {
          "command": "continuous.focusEdit",
          "group": "Continuous",
          "when": "!editorReadonly"
        }
      ],
      "explorer/context": [
        {
          "command": "continuous.selectFilesAsContext",
          "group": "1_debug@1"
        }
      ],
      "view/title": [
        {
          "command": "continuous.newSession",
          "group": "navigation@1",
          "when": "view == continuous.continueGUIView"
        },
        {
          "command": "continuous.viewHistory",
          "group": "navigation@2",
          "when": "view == continuous.continueGUIView"
        },
        {
          "command": "continuous.openConfigPage",
          "group": "navigation@4",
          "when": "view == continuous.continueGUIView"
        },
        {
          "command": "continuous.clearConsole",
          "group": "navigation@1",
          "when": "view == continuous.continueConsoleView"
        }
      ],
      "editor/title": [
        {
          "command": "continuous.newSession",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == continuous.continueGUIView"
        },
        {
          "command": "continuous.viewHistory",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == continuous.continueGUIView"
        }
      ],
      "terminal/context": [
        {
          "command": "continuous.debugTerminal",
          "group": "navigation@top"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "continuous",
          "title": "Continuous",
          "icon": "media/sidebar-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "continuousConsole",
          "title": "Continuous Console",
          "icon": "$(window)"
        }
      ]
    },
    "views": {
      "continuous": [
        {
          "type": "webview",
          "id": "continuous.continueGUIView",
          "name": "Continuous",
          "icon": "media/sidebar-icon.svg",
          "visibility": "visible"
        }
      ],
      "continuousConsole": [
        {
          "type": "webview",
          "id": "continuous.continueConsoleView",
          "name": "Continuous Console",
          "icon": "$(window)",
          "visibility": "visible",
          "when": "config.continuous.enableConsole"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.continue*/config.json",
        "url": "./config_schema.json"
      },
      {
        "fileMatch": [
          ".continuousrc.json",
          ".continuerc.json"
        ],
        "url": "./continue_rc_schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "**/.continuous/config.yaml",
          "**/.continuous/configs/*.yaml",
          "**/.continuous/agents/*.yaml",
          "**/.continuous/assistants/*.yaml",
          "**/.continue/config.yaml",
          "**/.continue/configs/*.yaml",
          "**/.continue/agents/*.yaml",
          "**/.continue/assistants/*.yaml"
        ],
        "url": "./config-yaml-schema.json"
      },
      {
        "fileMatch": [
          "**/.continuous/models.yaml",
          "**/.continue/models.yaml"
        ],
        "url": "./models-yaml-schema.json"
      },
      {
        "fileMatch": [
          "**/.continuous/providers.yaml",
          "**/.continue/providers.yaml"
        ],
        "url": "./providers-yaml-schema.json"
      }
    ]
  },
  "scripts": {
    "esbuild-base": "node scripts/esbuild.js",
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "esbuild-notify": "npm run esbuild-base -- --sourcemap --notify",
    "esbuild:visualize": "esbuild-visualizer --metadata ./build/meta.json --filename ./build/stats.html --open",
    "check:native-modules-deferred": "node scripts/check-native-modules-deferred.js",
    "tsc": "tsc -p ./",
    "tsc:check": "tsc -p ./ --noEmit",
    "tsc-watch": "tsc -watch -p ./",
    "rebuild": "electron-rebuild -v 19.1.8 node-pty",
    "lint": "eslint src",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "vitest": "vitest run",
    "write-build-timestamp": "node scripts/write-build-timestamp.js",
    "prepackage": "node scripts/prepackage.js",
    "package": "node scripts/package.js",
    "package-all": "node scripts/package-all.js",
    "package:pre-release": "node scripts/package.js --pre-release",
    "build:rust": "cargo-cp-artifact -ac sync sync.node -- cargo build --manifest-path ../../sync/Cargo.toml --message-format=json-render-diagnostics",
    "build-debug:rust": "npm run build:rust --",
    "build-release:rust": "npm run build:rust -- --release",
    "e2e:compile": "tsc -p ./tsconfig.e2e.json",
    "e2e:build": "npm --prefix ../../gui run build && npm run package",
    "e2e:create-storage": "mkdir -p ./e2e/storage",
    "e2e:get-chromedriver": "extest get-chromedriver --storage ./e2e/storage --code_version 1.144.0",
    "e2e:get-vscode": "extest get-vscode --storage ./e2e/storage --code_version 1.144.0",
    "e2e:sign-vscode": "codesign --entitlements entitlements.plist --deep --force -s - './e2e/storage/Visual Studio Code.app'",
    "e2e:copy-vsix": "chmod +x ./e2e/get-latest-vsix.sh && bash ./e2e/get-latest-vsix.sh",
    "e2e:install-vsix": "extest install-vsix -f ./e2e/vsix/continue.vsix --extensions_dir ./e2e/.test-extensions --storage ./e2e/storage",
    "e2e:install-extensions": "node scripts/install-e2e-extensions.js",
    "e2e:test": "NODE_ENV=e2e extest run-tests ${TEST_FILE:-'./e2e/_output/tests/*.test.js'} --code_settings settings.json --extensions_dir ./e2e/.test-extensions --storage ./e2e/storage",
    "e2e:clean": "rm -rf ./e2e/_output ./e2e/storage",
    "e2e:all": "npm run e2e:build && npm run e2e:compile && npm run e2e:create-storage && npm run e2e:get-chromedriver && npm run e2e:get-vscode && npm run e2e:sign-vscode && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test && npm run e2e:clean",
    "e2e:all-non-mac": "npm run e2e:build && npm run e2e:compile && npm run e2e:create-storage && npm run e2e:get-chromedriver && npm run e2e:get-vscode && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test && npm run e2e:clean",
    "e2e:recompile-extension": "npm run package && npm run e2e:compile && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test && npm run e2e:clean",
    "e2e:rebuild-gui": "rm -rf gui && cp -r ../../gui/dist gui && npm run package && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test && npm run e2e:clean",
    "e2e:quick": "npm run e2e:compile && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test && npm run e2e:clean",
    "e2e:ci:download": "npm run e2e:create-storage && npm run e2e:get-chromedriver && npm run e2e:get-vscode",
    "e2e:ci:run": "npm run e2e:compile && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test",

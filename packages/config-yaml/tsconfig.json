{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmitOnError": false,
    "types": ["node", "vitest/globals"],
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    // Use this package's zod for every import, including the one inside the
    // linked @continuedev/config-types; otherwise declaration emit can end up
    // naming types through ../config-types/node_modules/zod.
    "paths": {
      "zod": ["./node_modules/zod/index.d.cts"]
    }
  },
  "include": ["src/**/*"]
}
